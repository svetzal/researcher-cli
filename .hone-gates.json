{
  "gates": [
    {
      "name": "lint",
      "command": "uv run ruff check",
      "required": true
    },
    {
      "name": "format",
      "command": "uv run ruff format --check",
      "required": true
    },
    {
      "name": "test",
      "command": "uv run pytest",
      "required": true
    },
    {
      "name": "security-audit",
      "command": "uv run pip-audit --ignore-vuln CVE-2026-4539 --ignore-vuln CVE-2026-45829 --ignore-vuln CVE-2025-3000",
      "required": true
    }
  ]
}
